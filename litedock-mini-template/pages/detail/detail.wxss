.detail-page { padding-top: 24rpx; }

.ct-icon {
  width: 96rpx;
  height: 96rpx;
  flex: 0 0 96rpx;
  border-radius: 24rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 34rpx;
  font-weight: 700;
  margin-right: 20rpx;
}
.ct-meta { overflow: hidden; }
.ct-name { display: block; font-size: 32rpx; font-weight: 700; overflow: hidden; white-space: nowrap; text-overflow: ellipsis; }
/* 1.0.20 对比度对齐 Web：镜像名/状态/键值/端口文字统一加深一档。 */
.ct-image { display: block; font-size: 23rpx; color: #788298; margin-top: 6rpx; overflow: hidden; white-space: nowrap; text-overflow: ellipsis; }
.ct-state { display: flex; align-items: center; font-size: 24rpx; color: #556076; white-space: nowrap; margin-left: 12rpx; }
/* 1.0.19：本体徽标（详情页状态行） */
.self-flag { display: inline-flex; align-items: center; margin-left: 10rpx; padding: 1rpx 10rpx; border-radius: 12rpx; background: #e6ecff; color: #4657c8; font-size: 21rpx; font-weight: 700; white-space: nowrap; }

.kv { display: flex; align-items: flex-start; padding: 12rpx 0; }
.kv-k { width: 190rpx; flex: 0 0 190rpx; font-size: 24rpx; color: #6f7a91; }
.kv-v { flex: 1; min-width: 0; font-size: 25rpx; color: #333d54; word-break: break-all; }
.kv-mono { font-family: "SFMono-Regular", Consolas, monospace; }

.meter-detail { margin-bottom: 24rpx; }
.meter-label { display: flex; justify-content: space-between; font-size: 24rpx; color: #6f7a91; margin-bottom: 10rpx; }
.meter-label .strong { color: #333d54; }
/* 1.0.20：资源条对齐 Web——深灰蓝底槽 + 紫蓝渐变填充，小占比也清晰可见。 */
.bar { height: 12rpx; border-radius: 6rpx; background: rgba(30,40,70,.14); overflow: hidden; }
.bar-fill { height: 100%; border-radius: 6rpx; background: linear-gradient(90deg,#7c8cff,#a88bff); }
.bar-fill.warn { background: linear-gradient(90deg,#f5a742,#ef6b6b); }

.chips { display: flex; flex-wrap: wrap; }
.port-chip { min-height: 60rpx; font-size: 24rpx; font-weight: 600; color: #5566c9; background: rgba(124,140,255,.12); border: 1rpx solid rgba(124,140,255,.28); }
.no-port { font-size: 24rpx; color: #8b93a5; }

.port-table { margin-top: 16rpx; border-top: 1rpx solid #eef1f7; }
.port-row { display: flex; align-items: center; min-height: 72rpx; border-bottom: 1rpx solid #f3f5fa; }
.port-host { width: 240rpx; font-size: 25rpx; font-weight: 600; color: #5566c9; }
.port-desc { flex: 1; font-size: 23rpx; color: #788298; }

.op-grid { margin-bottom: 8rpx; }
/* 1.0.20：按钮对齐 Web 白底+清晰边框+深字，提升与卡面的层次对比。 */
.op {
  min-height: 84rpx;
  line-height: 84rpx;
  text-align: center;
  border-radius: 16rpx;
  background: rgba(255,255,255,.92);
  border: 1rpx solid rgba(30,40,70,.16);
  color: #3f4a61;
  font-size: 26rpx;
  font-weight: 600;
  box-shadow: 0 2rpx 8rpx rgba(36,50,90,.06);
}
.op-primary { background: #6c7cff; color: #ffffff; border-color: #6c7cff; }
.op-danger { background: #fff1f0; color: #d0564a; border-color: #f7dcd9; }

.log-box {
  min-height: 200rpx;
  max-height: 520rpx;
  background: #1e2433;
  border-radius: 16rpx;
  padding: 20rpx;
  box-sizing: border-box;
}
.log-text { font-size: 21rpx; line-height: 1.7; color: #cfd7ea; font-family: "SFMono-Regular", Consolas, monospace; word-break: break-all; }
.log-box .tiny { color: #8b96ad; }
/* 日志自动刷新开关：默认亮起（每 5 秒），点一下回到手动。 */
.log-ops { display: flex; align-items: center; gap: 10rpx; }
.log-ops .btn { min-width: 84rpx; }
.log-ops .btn.on { color: #5566c9; background: rgba(124,140,255,.14); border-color: rgba(124,140,255,.55); }

/* ---------------- 1.0.5 概览卡背景与自定义图标 ---------------- */
.ct-icon { overflow: hidden; }
.ct-icon-img { width: 96rpx; height: 96rpx; }
/* 1.0.20：自定义图标铺满（内置图标保留比例） */
.ct-icon-img.icon-custom { object-fit: cover; }
.detail-overview { position: relative; overflow: hidden; }
.detail-ov-bg { position: absolute; left: 0; top: 0; width: 100%; height: 100%; z-index: 0; transform: scale(1.08); }
.detail-ov-mask { position: absolute; left: 0; top: 0; width: 100%; height: 100%; z-index: 1; }
.detail-overview > .row,
.detail-overview > .divider,
.detail-overview > .kv { position: relative; z-index: 2; }
.detail-overview.has-bg { background: #1b2233; }
.detail-overview.has-bg .ct-name,
.detail-overview.has-bg .kv-v { color: #ffffff; text-shadow: 0 1rpx 6rpx rgba(0, 0, 0, .5); }
.detail-overview.has-bg .ct-image,
.detail-overview.has-bg .ct-state,
.detail-overview.has-bg .kv-k { color: rgba(255, 255, 255, .85); }
.detail-overview.has-bg .self-flag { background: rgba(230, 236, 255, .94); color: #4657c8; }
.detail-overview.has-bg .divider { border-color: rgba(255, 255, 255, .2); background: rgba(255, 255, 255, .2); }
