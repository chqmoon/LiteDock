.about-page { padding-top: 24rpx; }

.brand-card {
  display: flex;
  flex-direction: column;
  align-items: center;
  background: linear-gradient(150deg, #eef1ff 0%, #f7f3ff 60%, #eaf7ff 100%);
  border-radius: 28rpx;
  padding: 48rpx 24rpx 44rpx;
  margin-bottom: 20rpx;
}
.brand-mark {
  display: block;
  width: 112rpx;
  height: 112rpx;
  border-radius: 22%;
  margin-bottom: 24rpx;
  box-shadow: 0 12rpx 26rpx rgba(20, 96, 226, .22);
}
.brand-name { font-size: 40rpx; font-weight: 700; color: #2b3350; }
.brand-sub { font-size: 25rpx; color: #7d869c; margin-top: 10rpx; }
.brand-ver { font-size: 22rpx; color: #9aa3b2; margin-top: 16rpx; }

.kv { display: flex; align-items: flex-start; padding: 12rpx 0; }
.kv-k { width: 190rpx; flex: 0 0 190rpx; font-size: 24rpx; color: #8b93a5; }
.kv-v { flex: 1; min-width: 0; font-size: 24rpx; color: #3f4859; word-break: break-all; }

.license-text { display: block; font-size: 24rpx; line-height: 1.8; color: #6b7385; }
.license-gap { margin-top: 16rpx; }
.about-sign {
  display: block;
  text-align: center;
  font-size: 23rpx;
  font-weight: 600;
  letter-spacing: 2rpx;
  color: #9aa3b2;
  padding: 32rpx 0 8rpx;
  border-top: 1rpx solid #e9edf5;
  margin-top: 12rpx;
}
.foot-space { height: 40rpx; }
