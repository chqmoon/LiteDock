/* LiteDock Mini — 全局设计 token
   移动端规范：正文 28rpx / 辅助 24rpx / 点击区 ≥ 88rpx / 卡片圆角 24rpx */
page {
  min-height: 100%;
  background: #f4f6fb;
  color: #1f2430;
  font-size: 28rpx;
  font-family: -apple-system, BlinkMacSystemFont, "PingFang SC", "Helvetica Neue", sans-serif;
  -webkit-font-smoothing: antialiased;
}

button {
  padding: 0;
  margin: 0;
  font-size: 28rpx;
  line-height: 1.4;
  border-radius: 16rpx;
  background: transparent;
  color: #1f2430;
}
button::after { border: none; }

.page {
  padding: 24rpx 24rpx calc(48rpx + env(safe-area-inset-bottom));
}

.card {
  background: #ffffff;
  border-radius: 24rpx;
  padding: 24rpx;
  margin-bottom: 20rpx;
  box-shadow: 0 8rpx 30rpx rgba(36, 50, 90, .06);
}

.row { display: flex; align-items: center; }
.row-between { display: flex; align-items: center; justify-content: space-between; }
.grow { flex: 1; min-width: 0; }

.title { font-size: 36rpx; font-weight: 700; letter-spacing: .5rpx; }
.subtitle { font-size: 24rpx; color: #8b93a5; margin-top: 6rpx; }
.section-title { font-size: 28rpx; font-weight: 700; color: #1f2430; }
.muted { font-size: 24rpx; color: #8b93a5; }
.tiny { font-size: 22rpx; color: #a3aab9; }
.strong { font-weight: 700; }

.btn {
  min-height: 88rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 18rpx;
  background: #f1f3fa;
  color: #3f4859;
  font-size: 28rpx;
  font-weight: 600;
}
.btn-primary { background: #6c7cff; color: #ffffff; }
.btn-ghost { background: #ffffff; border: 1rpx solid #e5e9f2; color: #4a5468; }
.btn-danger { background: #fff1f0; color: #d0564a; }
.btn-small { min-height: 64rpx; font-size: 25rpx; border-radius: 14rpx; padding: 0 22rpx; }
.btn[disabled] { opacity: .45; }

/* 1.0.4 按钮间距：微信内置 button 带 margin-left/right:auto，
   优先级高于页面里的 .op / .btn 边距，flex 下会解析成 0，按钮就贴在一起。
   改为外层 view 的 padding 制造间隙，不依赖 button 自身 margin。 */
.btn-row, .op-grid, .ct-ops { display: flex; align-items: stretch; margin-left: -10rpx; margin-right: -10rpx; }
.btn-cell, .op-cell {
  flex: 1 1 0;
  min-width: 0;
  box-sizing: border-box;
}
.btn-cell { padding: 0 10rpx; }
.op-cell { padding: 8rpx 10rpx; }
.btn-cell .btn { width: 100%; margin: 0; box-sizing: border-box; }
.op-cell .op { display: block; width: 100%; margin: 0; box-sizing: border-box; }
.mini-cell { flex: 0 0 auto; padding-right: 16rpx; }
.mini-cell:last-child { padding-right: 0; }
.mini-cell .mini-btn { display: block; width: 100%; margin: 0; }

.chip {
  display: inline-flex;
  align-items: center;
  min-height: 56rpx;
  padding: 0 20rpx;
  border-radius: 14rpx;
  background: #f1f3fa;
  color: #4a5468;
  font-size: 24rpx;
  margin: 0 12rpx 12rpx 0;
}

.divider { height: 1rpx; background: #eef1f7; margin: 20rpx 0; }

.state-card {
  background: #ffffff;
  border-radius: 24rpx;
  padding: 72rpx 40rpx;
  text-align: center;
  box-shadow: 0 8rpx 30rpx rgba(36, 50, 90, .06);
}
.state-icon {
  display: block;
  font-size: 72rpx;
  color: #c3c9da;
  margin-bottom: 20rpx;
}
.state-title { display: block; font-size: 32rpx; font-weight: 700; margin-bottom: 12rpx; }
.state-desc { display: block; font-size: 25rpx; color: #8b93a5; line-height: 1.7; margin-bottom: 32rpx; }

.field { margin-bottom: 28rpx; }
.field-label { display: block; font-size: 25rpx; color: #6b7385; margin-bottom: 12rpx; font-weight: 600; }
.field-input {
  width: 100%;
  min-height: 88rpx;
  box-sizing: border-box;
  padding: 0 24rpx;
  border-radius: 18rpx;
  background: #f6f8fc;
  border: 1rpx solid #e9edf5;
  font-size: 28rpx;
  color: #1f2430;
}
.field-hint { display: block; font-size: 22rpx; color: #a3aab9; margin-top: 10rpx; line-height: 1.6; }

.led { width: 16rpx; height: 16rpx; border-radius: 50%; display: inline-block; margin-right: 10rpx; }

.notice {
  background: #f0f3ff;
  border-radius: 18rpx;
  padding: 20rpx 24rpx;
  font-size: 24rpx;
  color: #5a6480;
  line-height: 1.7;
}
.notice-warn { background: #fff7ec; color: #8a6a3c; }
